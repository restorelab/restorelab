# Binaries: anchored to the repo root, otherwise "restorelab" would also
# ignore cmd/restorelab/
/bin/
/dist/
/restorelab
/restorelab.exe

# Go
*.test
*.out
coverage.*

# Local state and secrets: never commit these
*.key
master.key
/config.yaml
config.local.yaml
.env
.env.*
!.env.example

# Reports produced by local runs
/reports/
*.report.json
*.report.html

# Frontend
node_modules/
web/.vite/

# The dashboard build lands in internal/ui/dist, where go:embed picks it up.
# The .gitkeep is committed so that `go build ./...` stays green on a machine
# that has never run the front-end build: go:embed fails at compile time on a
# directory with nothing embeddable in it.
internal/ui/dist/*
!internal/ui/dist/.gitkeep

# Working notes, local to this working copy: session handover state and the
# design and implementation documents each phase was written from. They are
# kept on disk because they are worth having while working; they are not part
# of what the project ships.
/STATE.md
/docs/superpowers/

# Local tooling state and scratch worktrees
/.claude/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
